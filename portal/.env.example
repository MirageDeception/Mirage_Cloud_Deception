# Copy to .env.local before starting the portal. If you deployed hub/hub-bootstrap.yaml,
# run scripts/sync-env-from-stack.sh instead of filling this in by hand -- it reads the
# stack's Outputs and writes this file for you, so nothing here has to be hand-typed or
# kept in sync with what's actually deployed.

# Renameable prefix for every hub-infra resource (roles, bus, tables, state bucket).
# Must match the ResourcePrefix you deployed hub-bootstrap.yaml with.
MIRAGE_RESOURCE_PREFIX=mirage-ops
# Same value, exposed to the browser (a few UI autofill fields need it client-side).
# Next.js only inlines NEXT_PUBLIC_* vars, so this can't just read the one above --
# keep both in sync. sync-env-from-stack.sh writes both for you.
NEXT_PUBLIC_MIRAGE_RESOURCE_PREFIX=mirage-ops

# External ID the portal presents when assuming spoke deployment roles via STS.
# Must match the external_id in iam/spoke/deployment-role/terraform.tfvars.
# Generate with: python3 -c "import uuid; print(uuid.uuid4())"
MIRAGE_SPOKE_EXTERNAL_ID=

# Storage backend: 'aws' uses DynamoDB (default); 'local' uses flat files only.
# Use 'local' before the portal brain CloudFormation stack has been deployed.
STORAGE_BACKEND=local

# Hub account ID. REQUIRED -- there is no default; the portal fails loudly at
# startup rather than silently assuming an account.
MIRAGE_HUB_ACCOUNT_ID=

# Hub service role the portal chains through before assuming spoke/brain roles:
#   ambient (EC2 instance role) -> hub service role -> spoke|brain role.
# Defaults to arn:aws:iam::<MIRAGE_HUB_ACCOUNT_ID>:role/<MIRAGE_RESOURCE_PREFIX>-hub-service-role
# if unset; override only if the role name differs.
MIRAGE_HUB_SERVICE_ROLE_ARN=

# Single DynamoDB table for all portal state -- must match monitoring-brain.yaml.
MIRAGE_STATE_TABLE=mirage-ops-state

# Decoy-access detections (Active Alerts) table -- must match monitoring-brain.yaml's
# MirageAlertsTable. Defaults to "<MIRAGE_RESOURCE_PREFIX>-alerts" if unset.
MIRAGE_ALERTS_TABLE=

# Optional: human-readable tag in alert email subjects, e.g. "[MIRAGE] Unauthorized
# access - S3 - GetObject". Passed to Deploy Brain as the AlertLabel CFN parameter.
# Defaults to "MIRAGE" (the template's own default) if unset.
MIRAGE_ALERT_LABEL=

# AWS Organizations id (o-xxxx). CRITICAL: passed to Deploy Brain as the OrgId
# CFN param -> the hub event bus's cross-account PutEvents policy. If UNSET when
# you Deploy Brain, the bus policy is dropped and EVERY spoke's event forwarding
# fails silently (detection stops with no error). Always set this in real deploys.
MIRAGE_ORG_ID=

# Central Terraform state bucket for scenario + bootstrap state. Defaults to
# <MIRAGE_RESOURCE_PREFIX>-tfstate-<hub-account>-<region> if unset -- created by
# hub/hub-bootstrap.yaml, so this is normally filled in by sync-env-from-stack.sh.
MIRAGE_TFSTATE_BUCKET=

# The next two only matter if you're using advanced/ssm-private/ (VPC interface
# endpoints) instead of the default hub-bootstrap.yaml path -- leave both empty
# otherwise.
# Break-glass admin ARN(s) exempt from the tfstate bucket's VPCe deny.
MIRAGE_STATE_BUCKET_ADMIN_ARN=
# S3 GATEWAY VPC endpoint id (vpce-...) for the tfstate bucket VPCe restriction.
MIRAGE_STATE_VPCE_ID=

# EC2 portal instance role ARN -- granted PutObject on the host-audit bucket via
# the brain stack. Passed to Deploy Brain as PortalInstanceRoleArn. Empty skips.
MIRAGE_PORTAL_INSTANCE_ROLE_ARN=

# AWS region for the hub (state bucket, event bus, portal). Defaults to us-west-2.
AWS_REGION=us-west-2
# AWS_DEFAULT_REGION is also honored by the AWS SDK/CLI; keep it in sync.
AWS_DEFAULT_REGION=us-west-2

# Optional. Regions for the identity forwarding rule (role decoys), comma-separated. Unset =
# the 17 regions AWS enables by default. Setting it REPLACES that list, so to add opt-in
# regions, list the defaults too. Regions with deployed scenarios are always added.
# See "Forwarding rules" in docs/ARCHITECTURE.md.
MIRAGE_IDENTITY_REGIONS=
